{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.fg_frog.attack_switch": {
            "states": {
                "default": {
                    "transitions": [
                        {
                            "in_attack": "q.is_delayed_attacking"
                        }
                    ]
                },
                "in_attack": {
                    "transitions": [
                        {
                            "default": "q.is_delayed_attacking == 0"
                        }
                    ],
                    "on_exit": [
                        "@s fg:random_attack_function_event"
                    ]
                }
            }
        }
    }
}