{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.fg_crab.attack_switch": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "attack_left": "q.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack_left')"
                        },
                        {
                            "attack_right": "q.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack_right')"
                        },
                        {
                            "attack": "q.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack')"
                        }
                    ]
                },
                "attack_left": {
                    "transitions": [
                        {
                            "default": "q.is_delayed_attacking == 0"
                        }
                    ],
                    "on_exit": [
                        "@s fg:on_attack_left_complete"
                    ]
                },
                "attack_right": {
                    "transitions": [
                        {
                            "default": "q.is_delayed_attacking == 0"
                        }
                    ],
                    "on_exit": [
                        "@s fg:on_attack_right_complete"
                    ]
                },
                "attack": {
                    "transitions": [
                        {
                            "default": "q.is_delayed_attacking == 0"
                        }
                    ],
                    "on_exit": [
                        "@s fg:on_attack_complete"
                    ]
                }
            }
        }
    }
}
