{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "fg:crab_red_tide",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:sand", "minecraft:red_sand", "minecraft:gravel"],
        "minecraft:brightness_filter": { "min": 8, "max": 15, "adjust_for_weather": true },
        "minecraft:height_filter": { "min": 50, "max": 72 },
        "minecraft:weight": { "default": 2 },
        "minecraft:herd": { "min_size": 1, "max_size": 3 },
        "minecraft:density_limit": { "surface": 1 },
        "minecraft:biome_filter": {
          "all_of": [
            { "any_of": [
              { "test": "has_biome_tag", "operator": "==", "value": "beach" },
              { "test": "has_biome_tag", "operator": "==", "value": "ocean" }
            ]},
            { "none_of": [
              { "test": "has_biome_tag", "operator": "==", "value": "warm" },
              { "test": "has_biome_tag", "operator": "==", "value": "frozen" },
              { "test": "has_biome_tag", "operator": "==", "value": "swamp" },
              { "test": "has_biome_tag", "operator": "==", "value": "mangrove_swamp" }
            ]}
          ]
        }
      },
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:sand", "minecraft:red_sand", "minecraft:gravel"],
        "minecraft:brightness_filter": { "min": 8, "max": 15, "adjust_for_weather": true },
        "minecraft:height_filter": { "min": 50, "max": 72 },
        "minecraft:weight": { "default": 2 },
        "minecraft:herd": { "min_size": 1, "max_size": 2 },
        "minecraft:density_limit": { "surface": 1 },
        "minecraft:biome_filter": {
          "all_of": [
            { "test": "has_biome_tag", "operator": "==", "value": "warm" },
            { "any_of": [
              { "test": "has_biome_tag", "operator": "==", "value": "beach" },
              { "test": "has_biome_tag", "operator": "==", "value": "ocean" }
            ]}
          ]
        }
      }
    ]
  }
}
