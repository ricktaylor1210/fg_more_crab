{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "fg:fg_crab",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": [
          "minecraft:sand",
          "minecraft:red_sand",
          "minecraft:gravel"
        ],
        "minecraft:brightness_filter": {
          "min": 8,
          "max": 15,
          "adjust_for_weather": true
        },
        "minecraft:height_filter": {
          "min": 50,
          "max": 72
        },
        "minecraft:weight": {
          "default": 6
        },
        "minecraft:herd": {
          "min_size": 2,
          "max_size": 4
        },
        "minecraft:density_limit": {
          "surface": 4
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "beach"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "ocean"
            }
          ]
        }
      }
    ]
  }
}
