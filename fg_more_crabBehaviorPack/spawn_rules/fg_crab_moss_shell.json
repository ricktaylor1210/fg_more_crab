{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "fg:crab_moss_shell",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:mud", "minecraft:clay", "minecraft:sand", "minecraft:gravel"],
        "minecraft:brightness_filter": { "min": 8, "max": 15, "adjust_for_weather": true },
        "minecraft:height_filter": { "min": 50, "max": 72 },
        "minecraft:weight": { "default": 4 },
        "minecraft:herd": { "min_size": 1, "max_size": 3 },
        "minecraft:density_limit": { "surface": 2 },
        "minecraft:biome_filter": {
          "any_of": [
            { "test": "has_biome_tag", "operator": "==", "value": "mangrove_swamp" },
            { "test": "has_biome_tag", "operator": "==", "value": "swamp" }
          ]
        }
      }
    ]
  }
}
