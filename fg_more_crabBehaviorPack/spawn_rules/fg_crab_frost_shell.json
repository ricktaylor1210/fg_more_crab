{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "fg:crab_frost_shell",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:gravel", "minecraft:snow", "minecraft:ice", "minecraft:packed_ice"],
        "minecraft:brightness_filter": { "min": 8, "max": 15, "adjust_for_weather": true },
        "minecraft:height_filter": { "min": 50, "max": 80 },
        "minecraft:weight": { "default": 5 },
        "minecraft:herd": { "min_size": 2, "max_size": 3 },
        "minecraft:density_limit": { "surface": 2 },
        "minecraft:biome_filter": {
          "all_of": [
            { "test": "has_biome_tag", "operator": "==", "value": "frozen" },
            { "any_of": [
              { "test": "has_biome_tag", "operator": "==", "value": "beach" },
              { "test": "has_biome_tag", "operator": "==", "value": "ocean" }
            ]}
          ]
        }
      }
    ]
  }
}
