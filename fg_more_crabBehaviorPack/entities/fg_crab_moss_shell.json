            "add": {
              "component_groups": [
                "groups:tamed_follow"
              ]
            }
          }
        ]
      },
      "fg:equip_backpack": {
        "sequence": [
          {
            "set_property": {
              "fg:has_backpack": true
            }
          },
          {
            "add": {
              "component_groups": [
                "groups:crab_backpack_inventory"
              ]
            }
          }
        ]
      },
      "fg:unequip_backpack": {
        "sequence": [
          {
            "set_property": {
              "fg:has_backpack": false
            }
          },
          {
            "queue_command": {
              "command": [
                "loot spawn ~ ~0.7 ~ loot \"gameplay/fg_crab_backpack_drop\""
              ]
            }
          },
          {
            "remove": {
              "component_groups": [
                "groups:crab_backpack_inventory"
              ]
            }
          }
        ]
      },
      "fg:request_unequip_backpack": {
        "sequence": [
          {
            "queue_command": {
              "command": [
                "particle minecraft:basic_smoke_particle ~ ~0.8 ~"
              ]
            }
          }
        ]
      }
    }
  }
}
