{
    "format_version": "1.21.50",
    "minecraft:entity": {
        "description": {
            "identifier": "fg:fg_crab",
            "spawn_category": "creature",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false,
            "scripts": {
                "animate": [
                    "fg:attack_switch"
                ]
            },
            "animations": {
                "fg:attack_switch": "controller.animation.fg_crab.attack_switch"
            },
            "properties": {
                "fg:attack_mode": {
                    "type": "enum",
                    "values": [
                        "attack_left",
                        "attack_right",
                        "attack"
                    ],
                    "default": "attack_left",
                    "client_sync": true
                },
                "fg:attack_pattern": {
                    "type": "enum",
                    "values": [
                        "standard",
                        "aggressive"
                    ],
                    "default": "standard",
                    "client_sync": true
                },
                "fg:temper_state": {
                    "type": "enum",
                    "values": [
                        "calm",
                        "warning",
                        "enraged"
                    ],
                    "default": "calm",
                    "client_sync": false
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "mob",
                    "animal",
                    "crab",
                    "fg_crab"
                ]
            },
            "minecraft:nameable": {},
            "minecraft:collision_box": {
                "width": 0.425,
                "height": 0.3
            },
            "minecraft:health": {
                "value": 10,
                "max": 10
            },
            "minecraft:movement": {
                "value": 0.18
            },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:navigation.generic": {
                "can_path_over_water": true,
                "avoid_water": false,
                "can_sink": false
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0,
                "inhale_time": 0,
                "breathes_air": true,
                "breathes_water": true,
                "generates_bubbles": false
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/fg_crab.json"
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "on_damage": {
                            "filters": {
                                "test": "enum_property",
                                "domain": "fg:temper_state",
                                "value": "calm"
                            },
                            "event": "fg:on_first_hit"
                        }
                    },
                    {
                        "on_damage": {
                            "filters": {
                                "test": "enum_property",
                                "domain": "fg:temper_state",
                                "value": "warning"
                            },
                            "event": "fg:on_second_hit"
                        }
                    },
                    {
                        "on_damage": {
                            "filters": {
                                "test": "enum_property",
                                "domain": "fg:temper_state",
                                "value": "enraged"
                            },
                            "event": "fg:refresh_enrage"
                        }
                    }
                ]
            },
            "minecraft:behavior.random_stroll": {
                "priority": 8,
                "speed_multiplier": 1.0
            },
            "minecraft:behavior.look_at_player": {
                "priority": 9,
                "look_distance": 6,
                "probability": 0.08
            },
            "minecraft:behavior.random_look_around": {
                "priority": 10
            },
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:behavior.float": {
                "priority": 0
            }
        },
        "component_groups": {
            "groups:calm": {
                "minecraft:behavior.avoid_mob_type": {
                    "priority": 3,
                    "entity_types": [
                        {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "max_dist": 6,
                            "max_flee": 8,
                            "walk_speed_multiplier": 1.15,
                            "sprint_speed_multiplier": 1.35
                        }
                    ]
                }
            },
            "groups:warning": {
                "minecraft:behavior.avoid_mob_type": {
                    "priority": 2,
                    "entity_types": [
                        {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "max_dist": 10,
                            "max_flee": 12,
                            "walk_speed_multiplier": 1.25,
                            "sprint_speed_multiplier": 1.55
                        }
                    ]
                },
                "minecraft:behavior.panic": {
                    "priority": 1,
                    "speed_multiplier": 1.45
                }
            },
            "groups:warning_reset_timer": {
                "minecraft:timer": {
                    "looping": false,
                    "time": 8.0,
                    "time_down_event": {
                        "event": "fg:reset_warning",
                        "target": "self"
                    }
                }
            },
            "groups:enraged": {
                "minecraft:behavior.hurt_by_target": {
                    "priority": 1,
                    "alert_same_type": true
                },
                "minecraft:behavior.nearest_attackable_target": {
                    "priority": 2,
                    "must_see": true,
                    "persist_time": 20,
                    "reselect_targets": true,
                    "within_radius": 10,
                    "entity_types": [
                        {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "max_dist": 10
                        }
                    ]
                },
                "minecraft:angry": {
                    "duration": 15,
                    "broadcast_anger": true,
                    "broadcast_anger_on_attack": true,
                    "broadcast_anger_on_being_attacked": true,
                    "broadcast_range": 16,
                    "broadcast_targets": [
                        "fg_crab"
                    ]
                }
            },
            "groups:enrage_reset_timer": {
                "minecraft:timer": {
                    "looping": false,
                    "time": 15.0,
                    "time_down_event": {
                        "event": "fg:calm_down",
                        "target": "self"
                    }
                }
            },
            "groups:attack_left": {
                "minecraft:attack": {
                    "damage": 2
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 4,
                    "reach_multiplier": 1.7,
                    "speed_multiplier": 1.2,
                    "attack_once": false,
                    "attack_duration": 0.45,
                    "hit_delay_pct": 0.5,
                    "can_spread_on_fire": false
                }
            },
            "groups:attack_right": {
                "minecraft:attack": {
                    "damage": 2
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 4,
                    "reach_multiplier": 1.7,
                    "speed_multiplier": 1.2,
                    "attack_once": false,
                    "attack_duration": 0.45,
                    "hit_delay_pct": 0.5,
                    "can_spread_on_fire": false
                }
            },
            "groups:attack": {
                "minecraft:attack": {
                    "damage": 4
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 4,
                    "reach_multiplier": 1.9,
                    "speed_multiplier": 1.15,
                    "attack_once": false,
                    "attack_duration": 0.58,
                    "hit_delay_pct": 0.5,
                    "can_spread_on_fire": false
                }
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": [
                                "groups:calm"
                            ]
                        }
                    },
                    {
                        "set_property": {
                            "fg:temper_state": "calm",
                            "fg:attack_pattern": "standard",
                            "fg:attack_mode": "attack_left"
                        }
                    },
                    {
                        "trigger": "fg:refresh_attack_group"
                    }
                ]
            },
            "fg:set_pattern_standard": {
                "sequence": [
                    {
                        "set_property": {
                            "fg:attack_pattern": "standard"
                        }
                    },
                    {
                        "trigger": "fg:reset_attack_mode"
                    }
                ]
            },
            "fg:set_pattern_aggressive": {
                "sequence": [
                    {
                        "set_property": {
                            "fg:attack_pattern": "aggressive"
                        }
                    },
                    {
                        "trigger": "fg:reset_attack_mode"
                    }
                ]
            },
            "fg:reset_attack_mode": {
                "sequence": [
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_pattern",
                            "value": "standard"
                        },
                        "set_property": {
                            "fg:attack_mode": "attack_left"
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_pattern",
                            "value": "aggressive"
                        },
                        "set_property": {
                            "fg:attack_mode": "attack"
                        }
                    },
                    {
                        "trigger": "fg:refresh_attack_group"
                    }
                ]
            },
            "fg:on_attack_left_complete": {
                "sequence": [
                    {
                        "set_property": {
                            "fg:attack_mode": "attack_right"
                        }
                    },
                    {
                        "trigger": "fg:refresh_attack_group"
                    }
                ]
            },
            "fg:on_attack_right_complete": {
                "sequence": [
                    {
                        "set_property": {
                            "fg:attack_mode": "attack"
                        }
                    },
                    {
                        "trigger": "fg:refresh_attack_group"
                    }
                ]
            },
            "fg:on_attack_complete": {
                "sequence": [
                    {
                        "set_property": {
                            "fg:attack_mode": "attack_left"
                        }
                    },
                    {
                        "trigger": "fg:refresh_attack_group"
                    }
                ]
            },
            "fg:refresh_attack_group": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:attack_left",
                                "groups:attack_right",
                                "groups:attack"
                            ]
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_mode",
                            "value": "attack_left"
                        },
                        "add": {
                            "component_groups": [
                                "groups:attack_left"
                            ]
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_mode",
                            "value": "attack_right"
                        },
                        "add": {
                            "component_groups": [
                                "groups:attack_right"
                            ]
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_mode",
                            "value": "attack"
                        },
                        "add": {
                            "component_groups": [
                                "groups:attack"
                            ]
                        }
                    }
                ]
            },
            "fg:on_first_hit": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:calm",
                                "groups:warning",
                                "groups:warning_reset_timer",
                                "groups:enraged",
                                "groups:enrage_reset_timer"
                            ]
                        }
                    },
                    {
                        "set_property": {
                            "fg:temper_state": "warning"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "groups:warning",
                                "groups:warning_reset_timer"
                            ]
                        }
                    }
                ]
            },
            "fg:on_second_hit": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:calm",
                                "groups:warning",
                                "groups:warning_reset_timer",
                                "groups:enraged",
                                "groups:enrage_reset_timer"
                            ]
                        }
                    },
                    {
                        "set_property": {
                            "fg:temper_state": "enraged"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "groups:enraged",
                                "groups:enrage_reset_timer"
                            ]
                        }
                    }
                ]
            },
            "fg:refresh_enrage": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:enrage_reset_timer"
                            ]
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "groups:enrage_reset_timer"
                            ]
                        }
                    }
                ]
            },
            "fg:reset_warning": {
                "sequence": [
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:temper_state",
                            "value": "warning"
                        },
                        "trigger": "fg:calm_down"
                    }
                ]
            },
            "fg:calm_down": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:calm",
                                "groups:warning",
                                "groups:warning_reset_timer",
                                "groups:enraged",
                                "groups:enrage_reset_timer"
                            ]
                        }
                    },
                    {
                        "set_property": {
                            "fg:temper_state": "calm"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "groups:calm"
                            ]
                        }
                    },
                    {
                        "reset_target": {}
                    },
                    {
                        "trigger": "fg:reset_attack_mode"
                    }
                ]
            }
        }
    }
}
