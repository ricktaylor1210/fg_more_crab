{
    "format_version": "1.21.50",
    "minecraft:entity": {
        "description": {
            "identifier": "fg:fg_crab_aggressive",
            "spawn_category": "creature",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false,
            "properties": {
                "fg:attack_mode": {
                    "type": "enum",
                    "values": [
                        "attack_left",
                        "attack_right",
                        "attack"
                    ],
                    "default": "attack",
                    "client_sync": true
                },
                "fg:attack_personality": {
                    "type": "enum",
                    "values": [
                        "calm",
                        "aggressive"
                    ],
                    "default": "aggressive",
                    "client_sync": false
                }
            },
            "animations": {
                "reset_attack_model": "controller.animation.fg_crab.reset_attack_model",
                "attack_switch": "controller.animation.fg_crab.attack_switch",
                "switch_attack_left": "animation.fg_crab.switch_attack_left",
                "switch_attack_right": "animation.fg_crab.switch_attack_right",
                "switch_attack_double": "animation.fg_crab.switch_attack_double"
            },
            "scripts": {
                "animate": [
                    "reset_attack_model",
                    "attack_switch"
                ]
            }
        },
        "component_groups": {
            "groups:untamed_anger": {
                "minecraft:angry": {
                    "duration": 25,
                    "broadcast_anger": true,
                    "broadcast_anger_on_being_attacked": true,
                    "broadcast_range": 20,
                    "broadcast_targets": [
                        "fg_crab_aggressive"
                    ]
                }
            },
            "groups:attack_left": {
                "minecraft:attack": {
                    "damage": 3
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 3,
                    "speed_multiplier": 1.2,
                    "reach_multiplier": 1.85,
                    "attack_duration": 0.45,
                    "cooldown_time": 0.12,
                    "hit_delay_pct": 0.52,
                    "track_target": true,
                    "attack_once": false
                }
            },
            "groups:attack_right": {
                "minecraft:attack": {
                    "damage": 3
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 3,
                    "speed_multiplier": 1.2,
                    "reach_multiplier": 1.85,
                    "attack_duration": 0.45,
                    "cooldown_time": 0.12,
                    "hit_delay_pct": 0.52,
                    "track_target": true,
                    "attack_once": false
                }
            },
            "groups:attack_double": {
                "minecraft:attack": {
                    "damage": 6
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 3,
                    "speed_multiplier": 1.24,
                    "reach_multiplier": 2.0,
                    "attack_duration": 0.6,
                    "cooldown_time": 0.18,
                    "hit_delay_pct": 0.58,
                    "track_target": true,
                    "attack_once": false
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "mob",
                    "animal",
                    "crab",
                    "fg_crab",
                    "fg_crab_aggressive"
                ]
            },
            "minecraft:collision_box": {
                "width": 0.95,
                "height": 0.6
            },
            "minecraft:health": {
                "value": 12,
                "max": 12
            },
            "minecraft:movement": {
                "value": 0.17
            },
            "minecraft:movement.basic": {},
            "minecraft:navigation.walk": {
                "can_path_over_water": false,
                "can_sink": false,
                "can_float": true,
                "avoid_water": false
            },
            "minecraft:jump.static": {},
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:nameable": {},
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.random_stroll": {
                "priority": 6,
                "speed_multiplier": 1.0,
                "xz_dist": 8,
                "y_dist": 2,
                "interval": 40
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 6,
                "probability": 0.04
            },
            "minecraft:behavior.random_look_around": {
                "priority": 8
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/fg_crab_help.json"
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1,
                "alert_same_type": false
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": [
                                "groups:untamed_anger"
                            ]
                        }
                    },
                    {
                        "remove": {
                            "component_groups": [
                                "groups:attack_left",
                                "groups:attack_right",
                                "groups:attack_double"
                            ]
                        }
                    },
                    {
                        "trigger": "fg:reset_attack_cycle_by_personality"
                    }
                ]
            },
            "fg:reset_attack_cycle_by_personality": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:attack_left",
                                "groups:attack_right",
                                "groups:attack_double"
                            ]
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_personality",
                            "value": "calm"
                        },
                        "add": {
                            "component_groups": [
                                "groups:attack_left"
                            ]
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_personality",
                            "value": "calm"
                        },
                        "set_property": {
                            "fg:attack_mode": "attack_left"
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_personality",
                            "value": "aggressive"
                        },
                        "add": {
                            "component_groups": [
                                "groups:attack_double"
                            ]
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "fg:attack_personality",
                            "value": "aggressive"
                        },
                        "set_property": {
                            "fg:attack_mode": "attack"
                        }
                    }
                ]
            },
            "fg:switch_to_attack_left": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:attack_left",
                                "groups:attack_right",
                                "groups:attack_double"
                            ]
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "groups:attack_left"
                            ]
                        }
                    },
                    {
                        "set_property": {
                            "fg:attack_mode": "attack_left"
                        }
                    }
                ]
            },
            "fg:switch_to_attack_right": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:attack_left",
                                "groups:attack_right",
                                "groups:attack_double"
                            ]
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "groups:attack_right"
                            ]
                        }
                    },
                    {
                        "set_property": {
                            "fg:attack_mode": "attack_right"
                        }
                    }
                ]
            },
            "fg:switch_to_attack_double": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "groups:attack_left",
                                "groups:attack_right",
                                "groups:attack_double"
                            ]
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "groups:attack_double"
                            ]
                        }
                    },
                    {
                        "set_property": {
                            "fg:attack_mode": "attack"
                        }
                    }
                ]
            }
        }
    }
}
