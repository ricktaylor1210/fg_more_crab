{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.mc_default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.crab_backpack": {
      "geometry": "Geometry.crab_backpack",
