{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.fg_crab.controller": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "sideways_orientation",
                        "idle"
                    ],
                    "transitions": [
                        {
                            "attack_left": "query.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack_left')"
                        },
                        {
                            "attack_right": "query.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack_right')"
                        },
                        {
                            "attack": "query.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack')"
                        },
                        {
                            "move": "query.ground_speed > 0.01"
                        }
                    ],
                    "blend_transition": 0.12,
                    "blend_via_shortest_path": true
                },
                "move": {
                    "animations": [
                        "sideways_orientation",
                        "move"
                    ],
                    "transitions": [
                        {
                            "attack_left": "query.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack_left')"
                        },
                        {
                            "attack_right": "query.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack_right')"
                        },
                        {
                            "attack": "query.is_delayed_attacking && (q.property('fg:attack_mode') == 'attack')"
                        },
                        {
                            "idle": "query.ground_speed <= 0.01"
                        }
                    ],
                    "blend_transition": 0.12,
                    "blend_via_shortest_path": true
                },
                "attack_left": {
                    "animations": [
                        "sideways_orientation",
                        "attack_left"
                    ],
                    "transitions": [
                        {
                            "move": "query.any_animation_finished && (query.ground_speed > 0.01)"
                        },
                        {
                            "idle": "query.any_animation_finished"
                        }
                    ],
                    "blend_transition": 0.08,
                    "blend_via_shortest_path": true
                },
                "attack_right": {
                    "animations": [
                        "sideways_orientation",
                        "attack_right"
                    ],
                    "transitions": [
                        {
                            "move": "query.any_animation_finished && (query.ground_speed > 0.01)"
                        },
                        {
                            "idle": "query.any_animation_finished"
                        }
                    ],
                    "blend_transition": 0.08,
                    "blend_via_shortest_path": true
                },
                "attack": {
                    "animations": [
                        "sideways_orientation",
                        "attack"
                    ],
                    "transitions": [
                        {
                            "move": "query.any_animation_finished && (query.ground_speed > 0.01)"
                        },
                        {
                            "idle": "query.any_animation_finished"
                        }
                    ],
                    "blend_transition": 0.08,
                    "blend_via_shortest_path": true
                }
            }
        }
    }
}